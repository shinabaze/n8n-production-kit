    {
      "parameters": {
        "content": "## Webhook guard\nSet HOOK_SECRET in the n8n environment and activate this workflow.\n\nA call with the right `x-hook-secret` header gets 200. Any other call gets 403, and its execution ends in an error, so refusals show up in the executions list.",
        "width": 460,
        "height": 220
      },
      "id": "c2c2981b-3266-4eb6-85b6-a4d28c37ae1e",
      "name": "Read Me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -320
      ]
    },
    {
      "parameters": {
