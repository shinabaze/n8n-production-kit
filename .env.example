# Only needed to run the demos inside n8n. The tests need none of these.
LLM_KEY_1=
LLM_KEY_2=
LLM_KEY_3=
HOOK_SECRET=
# Code nodes can only read $env when this is false.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# For safe-dry-run/example_patch.py against a real n8n.
N8N_URL=http://localhost:5678
N8N_API_KEY=
